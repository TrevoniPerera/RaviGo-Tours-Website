# =========================================================
# RaviGo Tours — Environment Variables
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to source control.
# =========================================================

# ---- Resend (email delivery for enquiry form) -----
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Email Delivery -----
# The email address that receives enquiry form submissions
RESEND_TO_EMAIL=info@ravigo.lk

# ---- Site URL -----
# Used for sitemap, OG images, and canonical URLs.
# In local development: http://localhost:3000
# In production: https://ravigo.lk (update when domain is confirmed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Rate Limiting (optional) -----
# Uncomment and configure if you add Upstash Redis rate limiting in the future
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
